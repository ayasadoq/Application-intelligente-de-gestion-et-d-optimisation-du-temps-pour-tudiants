<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/navigation_dashboard">

    <fragment
        android:id="@+id/navigation_dashboard"
        android:name="com.studyflowai.ui.fragments.DashboardFragment"
        android:label="Dashboard"
        tools:layout="@layout/fragment_dashboard" />

    <fragment
        android:id="@+id/navigation_planner"
        android:name="com.studyflowai.ui.fragments.PlanningFragment"
        android:label="Smart Planner"
        tools:layout="@layout/fragment_planning" />

    <fragment
        android:id="@+id/navigation_tasks"
        android:name="com.studyflowai.ui.fragments.TasksFragment"
        android:label="Tasks"
        tools:layout="@layout/fragment_task_list" />

    <fragment
        android:id="@+id/navigation_focus"
        android:name="com.studyflowai.ui.fragments.PomodoroFragment"
        android:label="Focus Session"
        tools:layout="@layout/fragment_pomodoro" />

    <fragment
        android:id="@+id/navigation_analytics"
        android:name="com.studyflowai.ui.fragments.StatsFragment"
        android:label="Analytics"
        tools:layout="@layout/fragment_stats" />

    <fragment
        android:id="@+id/navigation_chat"
        android:name="com.studyflowai.ui.fragments.ChatFragment"
        android:label="Coach AI"
        tools:layout="@layout/fragment_chat" />

    <fragment
        android:id="@+id/navigation_full_gantt"
        android:name="com.studyflowai.ui.fragments.FullGanttFragment"
        android:label="Itinéraire Complet"
        tools:layout="@layout/fragment_full_gantt" />
</navigation>
