<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/windowBackground"
    tools:context="com.studyflowai.ui.WelcomeActivity">

    <!-- FOND PROFOND -->
    <View
        android:id="@+id/vBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/quantum_main_bg" />

    <!-- TOP NAV (Minimalist) -->
    <LinearLayout
        android:id="@+id/llTopNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLanguage"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FR"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="13sp"
            android:textStyle="bold"
            app:icon="@drawable/ic_language"
            app:iconSize="18dp"
            app:iconTint="?attr/colorOnSurfaceVariant" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTheme"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            app:icon="@drawable/ic_dark_mode"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="20dp"
            app:iconTint="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@+id/btnStart"
        app:layout_constraintTop_toBottomOf="@+id/llTopNav">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="40dp">

            <!-- GLOW BEHIND LOGO -->
            <View
                android:id="@+id/vLogoGlow"
                android:layout_width="250dp"
                android:layout_height="250dp"
                android:background="@drawable/circle_progress"
                android:alpha="0.15"
                app:layout_constraintBottom_toBottomOf="@+id/ivHeroLogo"
                app:layout_constraintEnd_toEndOf="@+id/ivHeroLogo"
                app:layout_constraintStart_toStartOf="@+id/ivHeroLogo"
                app:layout_constraintTop_toTopOf="@+id/ivHeroLogo" />

            <!-- LOGO MODERNE -->
            <ImageView
                android:id="@+id/ivHeroLogo"
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:layout_marginTop="40dp"
                android:src="@drawable/ic_welcome_logo"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:fontFamily="sans-serif-black"
                android:text="@string/app_name"
                android:textColor="?attr/colorOnSurface"
                android:textSize="46sp"
                android:letterSpacing="-0.04"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ivHeroLogo" />

            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="50dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="50dp"
                android:gravity="center"
                android:lineSpacingMultiplier="1.4"
                android:text="@string/hero_subtitle"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="17sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvTitle" />

            <!-- PREVIEW CARD RETIRÉE -->

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

    <!-- ACTIONS -->
    <LinearLayout
        android:id="@+id/llActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="24dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@+id/tvTerms">

        <!-- BOUTON GOOGLE FOCAL -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStart"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:backgroundTint="@null"
            android:background="@drawable/btn_google_gradient"
            android:elevation="8dp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.02"
            android:stateListAnimator="@null"
            android:text="@string/continue_with_google"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="18sp"
            app:icon="@drawable/common_google_signin_btn_icon_dark"
            app:iconGravity="textStart"
            app:iconPadding="16dp"
            app:iconSize="24dp"
            app:rippleColor="#4DFFFFFF" />

        <!-- BOUTON INVITÉ -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGuest"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:text="@string/guest_access"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="15sp"
            android:letterSpacing="0.05" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvTerms"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:alpha="0.5"
        android:text="@string/terms_accept"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
