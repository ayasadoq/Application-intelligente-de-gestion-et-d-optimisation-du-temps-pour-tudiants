<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme for Dark Mode. (Startup Style) -->
    <style name="Theme.TimeMaster" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/accent_indigo</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/accent_indigo</item>
        <item name="colorOnPrimaryContainer">@color/white</item>

        <!-- Secondary brand color. -->
        <item name="colorSecondary">#8B5CF6</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="colorTertiary">#D946EF</item>
        <item name="colorOnTertiary">#FFFFFF</item>

        <!-- Background and surface colors. -->
        <item name="android:windowBackground">#050508</item>
        <item name="colorSurface">#0F172A</item>
        <item name="colorOnSurface">#F8FAFC</item>
        <item name="colorSurfaceVariant">#1E293B</item>
        <item name="colorOnSurfaceVariant">#94A3B8</item>
        <item name="colorOutline">#334155</item>

        <!-- Feedback colors. -->
        <item name="colorError">#EF4444</item>
        <item name="colorOnError">#FFFFFF</item>
        <item name="colorSuccess">#22C55E</item>
        <item name="colorOnSuccess">#050508</item>
        <item name="colorWarning">#F59E0B</item>
        <item name="colorOnWarning">#050508</item>

        <!-- Status bar and navigation bar. -->
        <item name="android:statusBarColor">#050508</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">#050508</item>
    </style>
</resources>
